{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Otter Pocket",
  "version": "0.1.0",
  "identifier": "art.milesyan.otterpocket",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Otter Pocket",
        "width": 1320,
        "height": 840,
        "minWidth": 760,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "Keep the references that matter, with a link back to the source",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA2NjdFODM5RTJGRDFGODUKUldTRkgvM2lPZWhuQmc0Nk9paVJzRmI3RHhyUkhIMUhBUDhRVElmNlBjaHJkTXhGWStQS2ZUSmoK",
      "endpoints": [
        "https://github.com/milesyan-art/OtterPocket-updates/releases/latest/download/latest.json"
      ]
    }
  }
}
